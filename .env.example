# Порт и адрес (по умолчанию только локальный доступ)
PORT=3000
HOST=127.0.0.1

# Провайдер ассоциативных картинок: pollinations (по умолчанию, без ключа) или openai
IMAGE_PROVIDER=pollinations
# Необязательный токен Pollinations, если сервис потребует авторизацию
# POLLINATIONS_TOKEN=
# Для провайдера openai:
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-1
