# Порт и адрес (по умолчанию только локальный доступ; 0.0.0.0 — доступ с телефона по Wi-Fi)
PORT=3000
HOST=127.0.0.1

# Провайдер ассоциативных картинок: huggingface | openai | pollinations
IMAGE_PROVIDER=huggingface

# huggingface: бесплатный токен с huggingface.co/settings/tokens
# (тип Fine-grained, право «Make calls to Inference Providers»)
# HF_TOKEN=hf_...
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# openai (платно):
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-1

# pollinations (может требовать ключ, иначе отвечает 402):
# POLLINATIONS_TOKEN=
